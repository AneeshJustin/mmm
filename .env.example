# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API (server/index.js)
API_PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/kerala-vivah
CORS_ORIGIN=http://localhost:3000

# Admin dashboard — set a strong secret
ADMIN_SECRET=change-me-to-a-secure-secret

# Email confirmations (optional — RSVP still saves without SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Kerala Vivah <your-email@gmail.com>"
